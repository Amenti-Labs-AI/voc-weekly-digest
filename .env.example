# Pin a version (>= 1.121.0 required by n8n UI) — avoid `latest`
N8N_VERSION=1.121.0
N8N_PORT=5678
N8N_HOST=localhost
WIREMOCK_PORT=8080
# Base URL for mock VOC APIs (n8n HTTP nodes use $env.VOC_MOCK_BASE_URL)
VOC_MOCK_BASE_URL=http://wiremock:8080
# Mock LLM provider base URLs — set these in n8n AI credentials (see README)
# OpenAI-compatible: must include /v1 (WireMock serves /v1/models, /v1/chat/completions)
VOC_OPENAI_BASE_URL=http://wiremock:8080/v1
# Anthropic-compatible: host root; WireMock serves /v1/messages
VOC_ANTHROPIC_BASE_URL=http://wiremock:8080
# Required API keys (for local demo, `mock` is valid with WireMock)
VOC_OPENAI_API_KEY=mock
VOC_ANTHROPIC_API_KEY=mock
# Optional default models (used when client profile does not specify one)
VOC_OPENAI_MODEL=gpt-4o-mini
VOC_ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
GENERIC_TIMEZONE=America/New_York
# Set false to skip auto-import on container start
N8N_AUTO_IMPORT_WORKFLOW=true
