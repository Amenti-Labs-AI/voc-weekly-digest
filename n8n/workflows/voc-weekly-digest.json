        "jsCode": "const fs = require('fs');\nconst pathProfile = '/config/client-profile.json';\nconst pathExample = '/config/client-profile.example.json';\nlet profile;\ntry {\n  profile = JSON.parse(fs.readFileSync(pathProfile, 'utf8'));\n} catch {\n  profile = JSON.parse(fs.readFileSync(pathExample, 'utf8'));\n}\n\nconst { normalizeVoc } = require('/lib/normalize-voc.js');\n\nconst amazon = $('HTTP Amazon Topics').first().json;\nconst dtc = $('HTTP DTC Reviews').first().json;\nconst marketplace = $('HTTP Marketplace Reviews').first().json;\nconst erp = $('HTTP ERP Returns').first().json;\n\nconst normalized = normalizeVoc(profile, { amazon, dtc, marketplace, erp });\n\nreturn [{\n  json: {\n    profile: { clientName: profile.clientName },\n    normalized,\n    exceptionOnly: profile.digest?.exceptionOnly !== false,\n  },\n}];"
