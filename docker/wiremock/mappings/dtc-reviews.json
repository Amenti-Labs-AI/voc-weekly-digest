{
  "scenarioName": "DTC Source Variation",
  "requiredScenarioState": "Started",
  "newScenarioState": "variant-2",
  "request": {
    "method": "GET",
    "urlPathPattern": "/mock/dtc/reviews"
  },
  "response": {
    "status": 200,
    "headers": { "Content-Type": "application/json" },
    "jsonBody": {
      "source": "dtc_review_app",
      "sku": "{{request.query.sku}}",
      "since": "{{request.query.since}}",
      "reviews": [
        {
          "id": "dtc-r-1001",
          "sku": "{{request.query.sku}}",
          "rating": 2,
          "title": "Pump stopped working",
          "body": "Worked for two weeks then the pump failed.",
          "createdAt": "2026-05-24T14:22:00Z",
          "verifiedPurchase": true,
          "themeHint": "pump_failure"
        },
        {
          "id": "dtc-r-1002",
          "sku": "{{request.query.sku}}",
          "rating": 5,
          "title": "Great value",
          "body": "Repeat buyer, consistent quality.",
          "createdAt": "2026-05-22T09:10:00Z",
          "verifiedPurchase": true,
          "themeHint": "easy_to_use"
        }
      ]
    },
    "transformers": ["response-template"]
  }
}
