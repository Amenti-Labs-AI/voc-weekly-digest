  "returnReasonMap": {
    "DEFECTIVE": ["pump_failure", "not_as_described"],
    "DAMAGED": ["packaging_damaged", "leak_or_spill"],
    "NOT_AS_DESCRIBED": ["not_as_described", "scent_too_strong"]
