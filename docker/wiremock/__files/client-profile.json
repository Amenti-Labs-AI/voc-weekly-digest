  "aiEvaluation": {
    "enabled": true,
    "provider": "anthropic",
    "model": "claude-3-5-sonnet-20241022",
    "models": {
      "anthropic": "claude-3-5-sonnet-20241022",
      "openai": "gpt-4o-mini"
    },
    "apiKeyEnv": {
      "anthropic": "VOC_ANTHROPIC_API_KEY",
      "openai": "VOC_OPENAI_API_KEY"
    },
    "instructions": "Prioritize product quality and fulfillment defects. Exclude positive-only praise from the exception digest unless corroborated by returns or defects.",
    "criteria": [
      {
        "id": "cross_source_corroboration",
        "description": "Theme must appear in at least two independent signal types",
        "weight": "high"
      },
      {
        "id": "returns_alignment",
        "description": "ERP return reason codes should support the theme when returns data is present",
        "weight": "high"
      },
      {
        "id": "materiality",
        "description": "Enough mentions to be material for executive action this week",
        "weight": "medium"
      },
      {
        "id": "exception_focus",
        "description": "De-prioritize positive-only praise themes for exception-only digests",
        "weight": "medium"
      }
    ]
  },
  "digest": {
    "exceptionOnly": true,
    "scheduleCron": "0 7 * * 1"
  }
